    <string name="onb_cameras_body">Watch four live cameras and take snapshots. With Privacy Guard on, the desk camera goes dark. Admins and operators can browse and replay recordings.</string>
    <string name="onb_logs_title">Logs &amp; roles</string>
    <string name="onb_logs_body">Every action and device event is logged, searchable and exportable as CSV. What you can do depends on your role: Admin, Operator or Guest.</string>

