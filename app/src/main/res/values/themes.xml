<resources>
    <!-- Same grey as the bg variable in style.css, so there is no white flash before the first frame is drawn -->
    <color name="desk_bg">#E8E8E8</color>
    <color name="desk_green">#00B33C</color>

    <style name="Theme.SmartDesk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/desk_bg</item>
        <item name="android:colorAccent">@color/desk_green</item>
    </style>
</resources>
